# Server-side only. Copy this file to .env and edit locally.
# npm start loads .env; Docker accepts it with --env-file .env.
# Never put a real key in frontend files, this example, or Git history.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Optional: external HTTPS origin when running behind a reverse proxy.
# PUBLIC_ORIGIN=https://calendar.example.com
